# Copy to .env (gitignored) for local development.

# PostgreSQL
POSTGRES_USER=aichat
POSTGRES_PASSWORD=aichat
POSTGRES_DB=aichat
POSTGRES_PORT=5433

# SuperTokens
SUPERTOKENS_PORT=3567
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=dev-key-change-me

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# API
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://aichat:aichat@localhost:5433/aichat

# App origins (SuperTokens app_info + browser calls)
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# LLM (OpenRouter — ADR-0018). Never commit a real key (ADR-0009).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT=60
