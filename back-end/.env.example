# Settings for the API itself.
#
# Copy to `back-end/.env` for anything that runs the API on the host — that is
# `just development`, `just back-end`, and the end-to-end suite. The
# containerized development stack (`just development-containerized`) loads this
# same file, so credentials live in one place rather than being pasted into two.
#
# Nothing here is required for a plain `just development`: every setting has a
# working default except the keys, and an empty key simply means that feature is
# off.

# --- SuperTokens ---------------------------------------------------------
# The API uses this to authenticate to the core. The core receives its own copy
# from `infrastructure/docker/.env`; the two must match.
SUPERTOKENS_API_KEY=dev-key-change-me

# Host-run default. The containerized API overrides this to reach the core by
# its service name.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# --- Database ------------------------------------------------------------
# Host-run default, pointing at the published port from
# `infrastructure/docker/compose.dev.yaml`. The containerized API overrides
# this to reach Postgres by its service name.
DATABASE_URL=postgresql+asyncpg://aichat:aichat@localhost:5433/aichat

# --- Origins (SuperTokens app_info, and where the browser calls) ---------
# Both must be the browser origin, and they must be equal, or SuperTokens treats
# the session cookie as cross-site and refuses it over plain HTTP. The native
# lane serves the SPA on the Vite port and proxies /api to the API, so the
# origin is that port — not the API's own :8000. The containerized stack
# overrides both to the same published Vite port.
API_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Social sign-in (optional) -------------------------------------------
# A provider is offered only when both halves are present, so leaving these
# blank simply means no social buttons — which is the point, and why they must
# not be filled with placeholders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email / SMTP (ADR-0030) ---------------------------------------------
# Development mail is caught by Mailpit (`just dependencies` starts it).
# `SMTP_HOST` is `localhost` when the API runs on the host; the containerized
# stack overrides it to the `mailpit` service name. Leave `SMTP_HOST` or
# `SMTP_FROM_EMAIL` empty to keep mail off — a reset request then fails loudly
# rather than reporting success and sending nothing.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=AI Chat
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# --- LLM (OpenRouter — ADR-0018) -----------------------------------------
# Never commit a real key (ADR-0009).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT=60

# --- Rate limiting (ADR-0020) --------------------------------------------
# `async+memory://` is per-process and fine for one API process. Switch to
# `async+redis://localhost:6379/0` on the host, or the compose stack's
# `async+redis://redis:6379/0`, once more than one process serves requests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=async+memory://
# JSON object of path prefix -> rate. The longest matching prefix wins, so a
# specific endpoint can be throttled tighter than the prefix around it.
RATE_LIMIT_RULES={"/api/v1/conversations":"20/minute","/api/auth":"20/minute","/api/auth/user/password/reset":"3/minute"}
RATE_LIMIT_FAIL_OPEN=true

# --- Token quota (ADR-0024) ----------------------------------------------
# A durable per-user budget layered under the provider's own spend cap.
TOKEN_QUOTA_ENABLED=true
TOKEN_QUOTA_TOKENS=100000
TOKEN_QUOTA_PERIOD=month
