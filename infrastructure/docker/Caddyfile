# Caddy — the self-hosted front door (ADR-0046).
#
# It serves the built SPA from /srv/web and proxies /api/* to the API, so the
# browser sees one origin. Development does not use Caddy: Vite's dev proxy
# provides the same single origin there.
#
# Set SITE_ADDRESS to the deployment's address. The default is a local,
# plain-HTTP smoke test; a real https domain makes Caddy obtain a certificate
# automatically, and nothing else changes.
{
    admin off
}

{$SITE_ADDRESS:http://localhost} {
    encode zstd gzip

    # No Strict-Transport-Security: it is ignored over HTTP and would only risk
    # pinning a local host to HTTPS. Over HTTPS Caddy adds it by default.
    header {
        X-Content-Type-Options "nosniff"
        # The reset link carries a single-use token in its query string. Any
        # third-party resource on the page would receive it as a Referer under
        # a weaker policy, so send none at all (ADR-0031).
        Referrer-Policy        "no-referrer"
    }

    handle /api/* {
        # Forward the path untouched: the app mounts its router at /api/v1 and
        # SuperTokens gates /api/auth, both of which need the prefix to survive.
        #
        # No flush_interval: Caddy flushes `text/event-stream` responses and
        # responses with unknown Content-Length immediately regardless, so SSE
        # streaming needs no setting (ADR-0046).
        reverse_proxy api:8000
    }

    handle {
        # The built SPA. `try_files` falls back to index.html so client-side
        # routes resolve on a direct load.
        root * /srv/web
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        # The reset link arrives as a URL query, so the default JSON access log
        # would write the token to disk. Redact it; keep the key so a token's
        # presence is still visible without its value (ADR-0031).
        format filter {
            wrap json
            request>uri query {
                replace token REDACTED
            }
        }
    }
}
