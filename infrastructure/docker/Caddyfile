# Caddy — TLS termination + routing
# /api/* -> FastAPI, everything else -> the front-end
#
# One file serves development and production. Only the SPA upstream differs:
# development points at the Vite dev server, production at the built assets
# (see the SPA_UPSTREAM comment on the `handle` block).
{
    admin off
}

# Development origin (ADR-0025). Plain HTTP: `localhost` is loopback, so no
# certificate is needed, and social providers special-case this exact host.
# Production replaces this address with a real domain; nothing else changes.
http://localhost {
    encode zstd gzip

    # No Strict-Transport-Security: it is ignored over HTTP and would only
    # risk pinning a local host to HTTPS. It belongs in the production block.
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy        "strict-origin-when-cross-origin"
    }

    handle /api/* {
        # Forward the path untouched: the app mounts its router at /api/v1 and
        # SuperTokens gates /api/auth, both of which need the prefix to survive.
        reverse_proxy api:8000 {
            # SSE streaming: don't buffer proxied event streams
            flush_interval -1
        }
    }

    handle {
        # The Vite dev server in development; a static build in production,
        # served with `file_server` instead. Both handle SPA history fallback,
        # so there is no `try_files` here.
        reverse_proxy {$SPA_UPSTREAM:front-end:5173}
    }

    log {
        output stdout
        format json
    }
}