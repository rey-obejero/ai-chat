# Caddy — TLS termination + routing
# /api/* -> FastAPI, everything else -> front-end static build
{
    admin off
}

:80 {
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy        "strict-origin-when-cross-origin"
    }

    handle /api/* {
        # Forward the path untouched: the app mounts its router at /api/v1 and
        # SuperTokens gates /api/auth, both of which need the prefix to survive.
        reverse_proxy api:8000 {
            # SSE streaming: don't buffer proxied event streams
            flush_interval -1
        }
    }

    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format json
    }
}
