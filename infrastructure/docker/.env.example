# Values Docker Compose substitutes into `compose.yaml`.
#
# Copy to `infrastructure/docker/.env` when the defaults below don't suit. Every
# one of these has a working default, so this file is only needed to change one
# — a different database password, or a port that is already taken.
#
# The application's own settings are NOT here. They live in
# `back-end/.env.example`; the api and migrate services load that file directly,
# so an LLM key or an OAuth secret exists in exactly one place.

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=aichat
POSTGRES_PASSWORD=aichat
POSTGRES_DB=aichat

# Host port, used only by the host-run paths (`just dependencies`, and the
# end-to-end suite). The development stack keeps Postgres unpublished.
POSTGRES_PORT=5433

# --- SuperTokens ---------------------------------------------------------
SUPERTOKENS_PORT=3567

# The core requires an API key, and the API authenticates to it with the same
# value. Keep this in sync with `back-end/.env`.
SUPERTOKENS_API_KEY=dev-key-change-me

# --- Redis ---------------------------------------------------------------
# Rate-limit counters only, and only when the API is configured to use it.
REDIS_PORT=6379

# --- Mailpit (development mail — ADR-0030) -------------------------------
# The SMTP port a host-run API sends to, and the HTTP port the inbox UI and
# its API are served on. The development stack publishes both.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
