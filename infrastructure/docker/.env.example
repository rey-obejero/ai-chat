# Values Docker Compose substitutes into `compose.dev.yaml` (and the other
# `compose.*.yaml` files in this directory).
#
# Copy to `infrastructure/docker/.env` when the defaults below don't suit. Every
# one of these has a working default, so this file is only needed to change one
# — a different database password, or a port that is already taken.
#
# The application's own settings are NOT here. They live in
# `back-end/.env.example`; the api and migrate services load that file directly,
# so an LLM key or an OAuth secret exists in exactly one place.

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=aichat
POSTGRES_PASSWORD=aichat
POSTGRES_DB=aichat

# Host port. Published by the development file so a host-run API can reach
# Postgres; the self-hosted file keeps it inside the compose network.
POSTGRES_PORT=5433

# --- SuperTokens ---------------------------------------------------------
# Host port, published by the development file for a host-run API. Keep in sync
# with `back-end/.env` (`SUPERTOKENS_CONNECTION_URI`).
SUPERTOKENS_PORT=3567

# The core requires an API key, and the API authenticates to it with the same
# value. Keep this in sync with `back-end/.env`.
SUPERTOKENS_API_KEY=dev-key-change-me

# --- Redis ---------------------------------------------------------------
# Rate-limit counters only, and only when the API is configured to use it.
REDIS_PORT=6379

# --- Mailpit (development mail — ADR-0030) -------------------------------
# The SMTP port a host-run API sends to, and the HTTP port the inbox UI and
# its API are served on. The development file publishes both; the self-hosted
# file does not.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# --- Development origin (development file only) --------------------------
# The browser origin for containerized development. Vite is published here and
# proxies /api to the API, so this is the single origin the app sees.
DEV_PORT=5173
DEV_ORIGIN=http://localhost:5173

# --- Self-hosted origin (self-hosted file only) --------------------------
# The address Caddy serves. `http://localhost` for a local smoke test; a real
# `https://…` domain in production, where Caddy obtains a certificate.
SITE_ADDRESS=http://localhost
HTTP_PORT=80

